# ─── Google Sheets Integration (server-side — set in Vercel dashboard) ───────
# 1. Create a Google Cloud project → enable Sheets API → create a Service Account
# 2. Download the JSON key file
# 3. Share your Google Spreadsheet with the service account email (Editor role)
# 4. Create 4 tabs named exactly: Personal Expenses | Business Expenses | Orders | Payments
# 5. Add the vars below in Vercel → Project Settings → Environment Variables

GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-from-the-url

# ─── Sheets API access guard (set BOTH to the same value in Vercel) ──────────
# Protects /api/sheets-log, /api/sheets-update, /api/sheets-delete from being
# called by anyone outside the app. Generate a long random string and set it
# as both vars below — VITE_ one is bundled into the client, the other is
# checked server-side.
VITE_SHEETS_API_SECRET=
SHEETS_API_SECRET=

# ─── Push Notifications / VAPID (future server-push, optional) ───────────────
VITE_VAPID_PUBLIC_KEY=
VITE_VAPID_PRIVATE_KEY=
